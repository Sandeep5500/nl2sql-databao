So to find album sales by artist, I need to:
- Join invoice_items → tracks → albums → artists
- Calculate total sales per artist
- Find the artist with the highest total sales
- Then find customers who bought albums from that artist
- Filter for those who spent less than $1
- Return their first names and spending amounts

Let me write the SQL query step by step.</think>Now I'll write the SQL query to find the customers who spent less than $1 on albums by the best-selling artist.

  → TOOL CALL: run_sql_query
    SQL: WITH artist_sales AS (
    -- Calculate total sales per artist (album sales)
    SELECT 
        a.ArtistId,
        a.Name AS ArtistName,
        SUM(ii.Quantity * ii.UnitPrice) AS TotalSales
    FROM artists a
    JOIN albums al ON a.ArtistId = al.ArtistId
    JOIN tracks t ON al.AlbumId = t.AlbumId
    JOIN invoice_items ii ON t.TrackId = ii.TrackId
    GROUP BY a.ArtistId, a.Name
    ORDER BY TotalSales DESC
),
best_artist AS (
    -- Get the best-selling artist
    SELECT ArtistId, ArtistName
    FROM artist_sales
    WHERE ArtistId = (SELECT ArtistId FROM artist_sales ORDER BY TotalSales DESC LIMIT 1)
),
customer_spending AS (
    -- Calculate total spending per customer on albums by the best-selling artist
    SELECT 
        c.CustomerId,
        c.FirstName,
        c.LastName,
        SUM(ii.Quantity * ii.UnitPrice) AS TotalSpent
    FROM customers c
    JOIN invoices i ON c.CustomerId = i.CustomerId
    JOIN invoice_items ii ON i.InvoiceId = ii.InvoiceId
    JOIN tracks t ON ii.TrackId = t.TrackId
    JOIN albums al ON t.AlbumId = al.AlbumId
    JOIN best_artist ba ON al.ArtistId = ba.ArtistId
    GROUP BY c.CustomerId, c.FirstName, c.LastName
    HAVING SUM(ii.Quantity * ii.UnitPrice) < 1
)
SELECT 
    FirstName,
    TotalSpent
FROM customer_spending
ORDER BY TotalSpent ASC;

