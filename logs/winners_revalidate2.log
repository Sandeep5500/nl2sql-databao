    h.hub_state,
    COUNT(CASE WHEN EXTRACT(MONTH FROM o.order_moment_finished) = 2 AND EXTRACT(YEAR FROM o.order_moment_finished) = 2026 THEN 1 END) AS feb_finished_orders,
    COUNT(CASE WHEN EXTRACT(MONTH FROM o.order_moment_finished) = 3 AND EXTRACT(YEAR FROM o.order_moment_finished) = 2026 THEN 1 END) AS mar_finished_orders,
    CASE 
        WHEN COUNT(CASE WHEN EXTRACT(MONTH FROM o.order_moment_finished) = 2 AND EXTRACT(YEAR FROM o.order_moment_finished) = 2026 THEN 1 END) = 0 
        THEN NULL 
        ELSE 100.0 * (COUNT(CASE WHEN EXTRACT(MONTH FROM o.order_moment_finished) = 3 AND EXTRACT(YEAR FROM o.order_moment_finished) = 2026 THEN 1 END) - COUNT(CASE WHEN EXTRACT(MONTH FROM o.order_moment_finished) = 2 AND EXTRACT(YEAR FROM o.order_moment_finished) = 2026 THEN 1 END)) / COUNT(CASE WHEN EXTRACT(MONTH FROM o.order_moment_finished) = 2 AND EXTRACT(YEAR FROM o.order_moment_finished) = 2026 THEN 1 END)
    END AS percentage_increase
FROM 
    delivery_center.main.hubs h
LEFT JOIN 
