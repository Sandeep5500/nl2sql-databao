# SLURM logs
logs/*.log
logs/*.err
logs/*.out

# Benchmark results CSVs
results/

# Python cache
scripts/__pycache__/
**/__pycache__/
*.pyc
.vllm-venv/

# runtime logs stay local, EXCEPT inspect logs + latest full-run traces
logs/*
!logs/inspect/
!logs/traces/
logs/traces/*
!logs/traces/v2_armAplus/
!logs/traces/v2_pass4_k1/
!logs/traces/v2_pass4_k2/
!logs/traces/v2_pass4_k3/
!logs/traces/v2_pass4_k4/
!logs/traces/q36_pass4_k1/
!logs/traces/q36_pass4_k2/
!logs/traces/q36_pass4_k3/
!logs/traces/q36_pass4_k4/
!logs/traces/q36s_pass4_k1/
!logs/traces/q36s_pass4_k2/
!logs/traces/q36s_pass4_k3/
!logs/traces/q36s_pass4_k4/
!logs/traces/q36rg_pass4_k1/
!logs/traces/q36rg_pass4_k2/
!logs/traces/q36rg_pass4_k3/
!logs/traces/q36rg_pass4_k4/
!logs/traces/q36f_pass4_k1/
